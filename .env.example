# Copy to backend/.env and fill in your own key.
# Without a key the backend runs in offline mode: retrieval and citations work,
# but answers are extractive instead of generated.

OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

CHUNK_SIZE=900
CHUNK_OVERLAP=120
TOP_K=5
MAX_UPLOAD_MB=20
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
